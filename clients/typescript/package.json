{
  "name": "@offset/client",
  "version": "0.7.0",
  "description": "TypeScript client for the offset terminal coding agent's bridge protocol",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/The-Masked-Bear/offset-terminal.git",
    "directory": "clients/typescript"
  },
  "type": "module",
  "main": "./out/src/index.js",
  "types": "./out/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./out/src/index.d.ts",
      "default": "./out/src/index.js"
    }
  },
  "files": ["out/src", "README.md"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc --noEmit -p .",
    "test": "tsc -p . && node --test \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.0"
  },
  "keywords": ["offset", "coding-agent", "jsonrpc", "bridge", "llm"]
}
